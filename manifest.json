{
  "manifest_version": 3,
  "name": "模型 · 额度监测 for ChatGPT",
  "version": "0.8.9",
  "description": "按实际额度窗口显示 Work / Codex 剩余额度，收纳时保留渐变进度条；收集本轮全部 model evidence，区分 requested/effective/auxiliary/unknown 后判断模型路由。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["bridge.js", "model.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["widget.js", "model-ui.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": ["storage"]
}
